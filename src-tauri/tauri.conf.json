{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Almanac",
  "version": "0.1.0",
  "identifier": "com.gilchrist.almanac",
  "build": {
    "frontendDist": "http://localhost:8787",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Almanac",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 540,
        "visible": false,
        "resizable": true,
        "url": "http://localhost:8787/"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "gilchrist",
    "category": "Productivity",
    "shortDescription": "Agent-native calendar",
    "longDescription": "A calendar for agents and their artifacts — iCalendar feeds with artifact-lineage checkmarks.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
